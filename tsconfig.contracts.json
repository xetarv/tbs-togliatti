{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "legacy",
    "types": []
  },
  "files": [
    "types/game-contracts.d.ts",
    "types/bootstrap-contracts.d.ts",
    "types/presentation-contracts.d.ts",
    "types/world-contracts.d.ts",
    "src/bootstrap/namespace.ts",
    "src/bootstrap/world.ts",
    "src/bootstrap/presentation.ts",
    "src/bootstrap/game.ts",
    "src/domain/state.ts",
    "src/application/game.ts",
    "src/domain/math.ts",
    "src/domain/config.ts",
    "src/domain/collision.ts",
    "src/domain/road-network.ts",
    "src/domain/traffic.ts",
    "src/domain/player-physics.ts",
    "src/domain/missions.ts",
    "src/application/session.ts",
    "src/application/mission-controller.ts"
  ],
  "include": ["src/**/*.ts"]
}

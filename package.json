{
  "name": "tbs-togliatti",
  "version": "1.0.0",
  "private": true,
  "description": "Offline 3D driving game set in Togliatti",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node tools/build-typescript.cjs --typecheck",
    "build": "node tools/build-typescript.cjs",
    "build:check": "node tools/build-typescript.cjs --check",
    "build:watch": "node tools/build-typescript.cjs --watch",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tools/check-browser.cjs",
    "check": "npm run lint && npm run format:check && npm run build:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
